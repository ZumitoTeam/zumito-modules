<div class="space-y-6">
    <header class="space-y-2">
        <h1 class="text-3xl font-semibold text-discord-foreground">Reacciones · Imágenes</h1>
        <p class="text-sm text-discord-foreground/70 max-w-3xl">
            Administra el banco de imágenes que el bot utilizará para cada categoría. Las traducciones y textos se ajustan desde la pestaña <strong>Categorías</strong>.
        </p>
    </header>

    <% if (feedback) { %>
        <div class="rounded-lg border px-4 py-3 text-sm shadow-sm flex items-start gap-3<%= feedback.type === 'success' ? ' border-discord-success/40 bg-discord-success/10 text-discord-success' : ' border-discord-danger/40 bg-discord-danger/10 text-discord-danger' %>">
            <span class="mt-1.5 h-2.5 w-2.5 rounded-full bg-current"></span>
            <p class="leading-relaxed"><%= feedback.text %></p>
        </div>
    <% } %>

    <% if (categories.length === 0) { %>
        <section class="card">
            <p class="text-sm text-discord-foreground/70">
                Aún no hay categorías registradas. Crea una desde la pestaña Categorías antes de gestionar imágenes.
            </p>
        </section>
    <% } else { %>
        <section class="space-y-4">
            <div class="space-y-1">
                <h2 class="text-xl font-semibold text-discord-foreground">Categorías disponibles</h2>
                <p class="text-sm text-discord-foreground/70">
                    Cada tarjeta muestra las imágenes por defecto y las personalizadas añadidas. Puedes subir nuevas imágenes o actualizar las existentes.
                </p>
            </div>

            <div class="space-y-4">
                <% categories.forEach((category) => { %>
                    <details class="space-y-5 rounded-lg border border-discord-dark-100 bg-discord-dark-200/80 p-5 shadow-lg">
                        <summary class="flex flex-wrap items-center gap-3 text-lg font-semibold text-discord-foreground cursor-pointer">
                            <span><%= category.displayName.es || category.displayName.en || category.key %></span>
                            <span class="text-sm font-normal text-discord-foreground/60">(<%= category.key %>)</span>
                            <% if (category.usesDefaultImages) { %>
                                <span class="inline-flex items-center gap-2 rounded-full border border-discord-dark-100 bg-discord-dark-100/60 px-3 py-1 text-xs font-semibold text-discord-foreground/80">
                                    Usando imágenes por defecto
                                </span>
                            <% } else { %>
                                <span class="inline-flex items-center gap-2 rounded-full border border-discord-success/40 bg-discord-success/10 px-3 py-1 text-xs font-semibold text-discord-success">
                                    Imágenes personalizadas activas
                                </span>
                            <% } %>
                        </summary>

                        <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-discord-foreground/70">
                            <span>Personalizadas: <%= (category.images || []).length %></span>
                            <span>Por defecto: <%= category.defaultImages.length %></span>
                            <span>Actualizado: <%= category.updatedAt ? new Date(category.updatedAt).toLocaleString() : 'Sin datos' %></span>
                        </div>

                        <% if (category.defaultImages.length) { %>
                            <div class="space-y-2">
                                <h3 class="text-sm font-semibold uppercase tracking-wide text-discord-foreground/60">Imágenes por defecto</h3>
                                <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                                    <% category.defaultImages.forEach((image) => { %>
                                        <div class="space-y-3 rounded-lg border border-discord-dark-100 bg-discord-dark-300/60 p-4">
                                            <span class="inline-flex items-center gap-2 rounded-full border border-discord-dark-100 bg-discord-dark-100/60 px-3 py-1 text-xs font-semibold text-discord-foreground/80">
                                                Imagen por defecto
                                            </span>
                                            <div class="overflow-hidden rounded-md border border-discord-dark-100 bg-discord-dark-300">
                                                <img src="<%= image.url %>" alt="<%= image.description?.es || image.description?.en || image.source %>" class="w-full object-cover" loading="lazy" />
                                            </div>
                                            <p class="text-xs text-discord-foreground/60">Fuente: <%= image.source %></p>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        <% } %>

                        <div class="space-y-4">
                            <h3 class="text-sm font-semibold uppercase tracking-wide text-discord-foreground/60">Imágenes personalizadas</h3>

                            <% if ((category.images || []).length === 0) { %>
                                <p class="text-sm text-discord-foreground/70">
                                    No hay imágenes personalizadas todavía. Se usarán las imágenes por defecto mientras tanto.
                                </p>
                            <% } %>

                            <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                                <% (category.images || []).forEach((image) => { %>
                                    <div class="space-y-4 rounded-lg border border-discord-dark-100 bg-discord-dark-300/60 p-4">
                                        <div class="space-y-3">
                                            <div class="overflow-hidden rounded-md border border-discord-dark-100 bg-discord-dark-300">
                                                <img src="<%= image.url %>" alt="<%= image.description?.es || image.description?.en || image.source %>" class="w-full object-cover" loading="lazy" />
                                            </div>
                                            <p class="text-xs text-discord-foreground/60">Fuente actual: <%= image.source %></p>
                                        </div>

                                        <form action="/admin/reactions/category/<%= category.key %>/images/update" method="POST" class="space-y-3">
                                            <input type="hidden" name="url" value="<%= image.url %>">

                                            <div class="space-y-2">
                                                <label class="block text-sm font-medium text-discord-foreground">Fuente</label>
                                                <input type="text" name="source" value="<%= image.source %>" required class="input" />
                                            </div>

                                            <div class="space-y-3">
                                                <label class="block text-sm font-medium text-discord-foreground">Descripción traducible (opcional)</label>
                                                <div class="translations space-y-3 rounded-lg bg-discord-dark-400/60 p-3" data-translation-group>
                                                    <template>
                                                        <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                                                            <input type="text" name="descriptionLocales[]" placeholder="Idioma" class="input w-full sm:w-36" />
                                                            <input type="text" name="descriptionValues[]" placeholder="Descripción" class="input w-full sm:flex-1" />
                                                            <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                                                        </div>
                                                    </template>
                                                    <% const descriptionEntries = Object.entries(image.description || {}); %>
                                                    <% if (descriptionEntries.length === 0) { %>
                                                        <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                                                            <input type="text" name="descriptionLocales[]" value="" class="input w-full sm:w-36" />
                                                            <input type="text" name="descriptionValues[]" value="" class="input w-full sm:flex-1" />
                                                            <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                                                        </div>
                                                    <% } else { %>
                                                        <% descriptionEntries.forEach(([locale, value]) => { %>
                                                            <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                                                                <input type="text" name="descriptionLocales[]" value="<%= locale %>" class="input w-full sm:w-36" />
                                                                <input type="text" name="descriptionValues[]" value="<%= value %>" class="input w-full sm:flex-1" />
                                                                <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                                                            </div>
                                                        <% }) %>
                                                    <% } %>
                                                    <button class="btn-secondary w-full sm:w-auto" type="button" data-add-translation>Añadir traducción</button>
                                                </div>
                                            </div>

                                            <div class="flex flex-wrap justify-end gap-2">
                                                <button class="btn-primary" type="submit">Actualizar</button>
                                            </div>
                                        </form>

                                        <form
                                            action="/admin/reactions/category/<%= category.key %>/images/delete"
                                            method="POST"
                                            class="flex flex-wrap justify-end"
                                            onsubmit="return confirm('¿Eliminar esta imagen?');"
                                        >
                                            <input type="hidden" name="url" value="<%= image.url %>">
                                            <button class="btn-danger" type="submit">Eliminar imagen</button>
                                        </form>
                                    </div>
                                <% }) %>
                            </div>
                        </div>

                        <div class="space-y-3">
                            <h4 class="text-sm font-semibold uppercase tracking-wide text-discord-foreground/60">Agregar nueva imagen</h4>
                            <form action="/admin/reactions/category/<%= category.key %>/images" method="POST" class="space-y-4">
                                <div class="image-row flex flex-col gap-3 md:flex-row">
                                    <div class="flex-1 space-y-2">
                                        <label class="block text-sm font-medium text-discord-foreground">URL del GIF/Imagen</label>
                                        <input type="url" name="url" placeholder="https://..." required class="input" />
                                    </div>
                                    <div class="md:w-64 space-y-2">
                                        <label class="block text-sm font-medium text-discord-foreground">Fuente</label>
                                        <input type="text" name="source" placeholder="Ej: Tenor" required class="input" />
                                    </div>
                                </div>

                                <div class="space-y-3">
                                    <label class="block text-sm font-medium text-discord-foreground">Descripción traducible (opcional)</label>
                                    <div class="translations space-y-3 rounded-lg bg-discord-dark-300/60 p-4" data-translation-group data-default-rows="2">
                                        <template>
                                            <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                                                <input type="text" name="descriptionLocales[]" placeholder="Idioma" class="input w-full sm:w-36" />
                                                <input type="text" name="descriptionValues[]" placeholder="Descripción" class="input w-full sm:flex-1" />
                                                <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                                            </div>
                                        </template>
                                        <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                                            <input type="text" name="descriptionLocales[]" value="es" class="input w-full sm:w-36" />
                                            <input type="text" name="descriptionValues[]" placeholder="Descripción en español" class="input w-full sm:flex-1" />
                                            <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                                        </div>
                                        <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                                            <input type="text" name="descriptionLocales[]" value="en" class="input w-full sm:w-36" />
                                            <input type="text" name="descriptionValues[]" placeholder="Description in English" class="input w-full sm:flex-1" />
                                            <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                                        </div>
                                        <button class="btn-secondary w-full sm:w-auto" type="button" data-add-translation>Añadir traducción</button>
                                    </div>
                                </div>

                                <div class="flex flex-wrap justify-end gap-2">
                                    <button class="btn-primary" type="submit">Añadir imagen</button>
                                </div>
                            </form>
                        </div>
                    </details>
                <% }) %>
            </div>
        </section>
    <% } %>
</div>

<script>
    const translationGroups = document.querySelectorAll('[data-translation-group]');

    translationGroups.forEach((group) => {
        group.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof HTMLElement)) {
                return;
            }

            if (target.matches('[data-add-translation]')) {
                event.preventDefault();
                const template = group.querySelector('template');
                if (!template || !(template instanceof HTMLTemplateElement)) {
                    return;
                }
                const fragment = template.content.cloneNode(true);
                const firstElement = fragment.firstElementChild;
                if (firstElement) {
                    group.insertBefore(firstElement, target);
                    const inputs = firstElement.querySelectorAll('input');
                    inputs.forEach((input) => {
                        input.removeAttribute('value');
                        if (input instanceof HTMLInputElement) {
                            input.value = '';
                        }
                    });
                }
                return;
            }

            if (target.matches('[data-remove-translation]')) {
                event.preventDefault();
                const row = target.closest('.translation-row');
                if (!row) {
                    return;
                }
                const rows = group.querySelectorAll('.translation-row');
                if (rows.length <= (Number(group.getAttribute('data-default-rows')) || 1)) {
                    return;
                }
                row.remove();
            }
        });
    });
</script>
