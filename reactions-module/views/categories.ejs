<div class="space-y-6">
    <header class="space-y-2">
        <h1 class="text-3xl font-semibold text-discord-foreground">Reacciones</h1>
        <p class="text-sm text-discord-foreground/70 max-w-3xl">
            Gestiona las categorías, textos y traducciones utilizados por el bot al publicar reacciones.
        </p>
    </header>

    <% if (feedback) { %>
        <div class="rounded-lg border px-4 py-3 text-sm shadow-sm flex items-start gap-3<%= feedback.type === 'success' ? ' border-discord-success/40 bg-discord-success/10 text-discord-success' : ' border-discord-danger/40 bg-discord-danger/10 text-discord-danger' %>">
            <span class="mt-1.5 h-2.5 w-2.5 rounded-full bg-current"></span>
            <p class="leading-relaxed"><%= feedback.text %></p>
        </div>
    <% } %>

    <section class="card space-y-4">
        <div>
            <h2 class="text-xl font-semibold text-discord-foreground">Crear nueva categoría</h2>
            <p class="text-sm text-discord-foreground/70 mt-1">
                Define un identificador y las traducciones base que usará el bot cuando publique reacciones.
            </p>
        </div>

        <div class="flex flex-wrap justify-end gap-2">
            <button class="btn-primary" type="button" data-open-category-modal>Crear categoría</button>
        </div>
    </section>

    <div
        id="createCategoryModal"
        class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/70 p-4"
        role="dialog"
        aria-modal="true"
        aria-labelledby="create-category-title"
        data-modal-state="closed"
    >
        <div
            class="w-full max-w-3xl rounded-lg border border-discord-dark-100 bg-discord-dark-200 p-6 shadow-2xl"
            data-modal-dialog
        >
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h2 id="create-category-title" class="text-xl font-semibold text-discord-foreground">
                        Crear nueva categoría
                    </h2>
                    <p class="mt-1 text-sm text-discord-foreground/70">
                        Define un identificador y las traducciones base que usará el bot cuando publique reacciones.
                    </p>
                </div>
                <button
                    type="button"
                    class="btn-secondary"
                    data-close-category-modal
                    aria-label="Cerrar"
                >
                    Cerrar
                </button>
            </div>

            <form action="/admin/reactions/category" method="POST" class="mt-6 space-y-5">
                <div class="space-y-2">
                    <label for="new-category-key" class="block text-sm font-medium text-discord-foreground">
                        Identificador único
                    </label>
                    <input
                        id="new-category-key"
                        type="text"
                        name="key"
                        placeholder="Ej: excited"
                        required
                        class="input"
                    />
                    <p class="text-xs text-discord-foreground/60">
                        Se usará para referenciar la categoría desde el bot y las traducciones.
                    </p>
                </div>

                <div class="space-y-3">
                    <label class="block text-sm font-medium text-discord-foreground">
                        Nombre para mostrar (opcional)
                    </label>
                    <div class="translations space-y-3 rounded-lg bg-discord-dark-300/60 p-4" data-translation-group data-modal-group data-default-rows="2">
                        <template>
                            <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                                <input type="text" name="displayNameLocales[]" placeholder="Idioma (ej: es)" class="input w-full sm:w-36" />
                                <input type="text" name="displayNameValues[]" placeholder="Texto" class="input w-full sm:flex-1" />
                                <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                            </div>
                        </template>
                        <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                            <input type="text" name="displayNameLocales[]" value="es" class="input w-full sm:w-36" />
                            <input type="text" name="displayNameValues[]" placeholder="Texto en español" class="input w-full sm:flex-1" />
                            <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                        </div>
                        <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                            <input type="text" name="displayNameLocales[]" value="en" class="input w-full sm:w-36" />
                            <input type="text" name="displayNameValues[]" placeholder="English text" class="input w-full sm:flex-1" />
                            <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                        </div>
                        <button class="btn-secondary w-full sm:w-auto" type="button" data-add-translation>Añadir traducción</button>
                    </div>
                </div>

                <div class="space-y-3">
                    <label class="block text-sm font-medium text-discord-foreground">
                        Mensaje con mención (obligatorio)
                    </label>
                    <div class="translations space-y-3 rounded-lg bg-discord-dark-300/60 p-4" data-translation-group data-modal-group data-default-rows="2">
                        <template>
                            <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                                <input type="text" name="mentionLocales[]" placeholder="Idioma (ej: es)" class="input w-full sm:w-36" />
                                <input type="text" name="mentionValues[]" placeholder="Ej: %user% reaccionó a %user2%" class="input w-full sm:flex-1" />
                                <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                            </div>
                        </template>
                        <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                            <input type="text" name="mentionLocales[]" value="es" class="input w-full sm:w-36" />
                            <input type="text" name="mentionValues[]" placeholder="%user% reaccionó a %user2%" class="input w-full sm:flex-1" />
                            <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                        </div>
                        <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                            <input type="text" name="mentionLocales[]" value="en" class="input w-full sm:w-36" />
                            <input type="text" name="mentionValues[]" placeholder="%user% reacted to %user2%" class="input w-full sm:flex-1" />
                            <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                        </div>
                        <button class="btn-secondary w-full sm:w-auto" type="button" data-add-translation>Añadir traducción</button>
                    </div>
                </div>

                <div class="space-y-3">
                    <label class="block text-sm font-medium text-discord-foreground">
                        Mensaje simple (obligatorio)
                    </label>
                    <div class="translations space-y-3 rounded-lg bg-discord-dark-300/60 p-4" data-translation-group data-modal-group data-default-rows="2">
                        <template>
                            <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                                <input type="text" name="simpleLocales[]" placeholder="Idioma (ej: es)" class="input w-full sm:w-36" />
                                <input type="text" name="simpleValues[]" placeholder="Ej: %user% reaccionó" class="input w-full sm:flex-1" />
                                <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                            </div>
                        </template>
                        <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                            <input type="text" name="simpleLocales[]" value="es" class="input w-full sm:w-36" />
                            <input type="text" name="simpleValues[]" placeholder="%user% reaccionó" class="input w-full sm:flex-1" />
                            <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                        </div>
                        <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                            <input type="text" name="simpleLocales[]" value="en" class="input w-full sm:w-36" />
                            <input type="text" name="simpleValues[]" placeholder="%user% reacted" class="input w-full sm:flex-1" />
                            <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                        </div>
                        <button class="btn-secondary w-full sm:w-auto" type="button" data-add-translation>Añadir traducción</button>
                    </div>
                </div>

                <div class="flex flex-wrap justify-end gap-2">
                    <button class="btn-secondary" type="button" data-close-category-modal>Cancelar</button>
                    <button class="btn-primary" type="submit">Crear categoría</button>
                </div>
            </form>
        </div>
    </div>

    <section class="space-y-4">
        <div class="space-y-1">
            <h2 class="text-xl font-semibold text-discord-foreground">Categorías configuradas</h2>
            <p class="text-sm text-discord-foreground/70">
                Ajusta los textos y traducciones utilizados cuando un usuario ejecuta la reacción. Las imágenes ahora se administran desde la pestaña <strong>Imágenes</strong>.
            </p>
        </div>

        <% if (categories.length === 0) { %>
            <p class="text-sm text-discord-foreground/70">No hay categorías configuradas aún.</p>
        <% } %>

        <div class="space-y-4">
            <% categories.forEach((category) => { %>
                <details class="space-y-5 rounded-lg border border-discord-dark-100 bg-discord-dark-200/80 p-5 shadow-lg">
                    <summary class="flex flex-wrap items-center gap-3 text-lg font-semibold text-discord-foreground cursor-pointer">
                        <span><%= category.displayName.es || category.displayName.en || category.key %></span>
                        <span class="text-sm font-normal text-discord-foreground/60">(<%= category.key %>)</span>
                        <% if (category.usesDefaultImages) { %>
                            <span class="inline-flex items-center gap-2 rounded-full border border-discord-dark-100 bg-discord-dark-100/60 px-3 py-1 text-xs font-semibold text-discord-foreground/80">
                                Usando imágenes por defecto
                            </span>
                        <% } else { %>
                            <span class="inline-flex items-center gap-2 rounded-full border border-discord-success/40 bg-discord-success/10 px-3 py-1 text-xs font-semibold text-discord-success">
                                Imágenes personalizadas activas
                            </span>
                        <% } %>
                    </summary>

                    <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-discord-foreground/70">
                        <span>Última actualización: <%= category.updatedAt ? new Date(category.updatedAt).toLocaleString() : 'Sin datos' %></span>
                        <% if (category.usesDefaultImages) { %>
                            <span><%= category.defaultImages.length %> imágenes disponibles en valores por defecto</span>
                        <% } else { %>
                            <span><%= (category.images || []).length %> imágenes personalizadas activas</span>
                        <% } %>
                    </div>

                    <form action="/admin/reactions/category" method="POST" class="space-y-4">
                        <input type="hidden" name="key" value="<%= category.key %>">

                        <div class="space-y-3">
                            <label class="block text-sm font-medium text-discord-foreground">Nombre para mostrar</label>
                            <div class="translations space-y-3 rounded-lg bg-discord-dark-300/60 p-4" data-translation-group>
                                <template>
                                    <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                                        <input type="text" name="displayNameLocales[]" placeholder="Idioma (ej: es)" class="input w-full sm:w-36" />
                                        <input type="text" name="displayNameValues[]" placeholder="Texto" class="input w-full sm:flex-1" />
                                        <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                                    </div>
                                </template>
                                <% const displayEntries = Object.entries(category.displayName || {}); %>
                                <% if (displayEntries.length === 0) { %>
                                    <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                                        <input type="text" name="displayNameLocales[]" value="" class="input w-full sm:w-36" />
                                        <input type="text" name="displayNameValues[]" value="" class="input w-full sm:flex-1" />
                                        <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                                    </div>
                                <% } else { %>
                                    <% displayEntries.forEach(([locale, value]) => { %>
                                        <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                                            <input type="text" name="displayNameLocales[]" value="<%= locale %>" class="input w-full sm:w-36" />
                                            <input type="text" name="displayNameValues[]" value="<%= value %>" class="input w-full sm:flex-1" />
                                            <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                                        </div>
                                    <% }) %>
                                <% } %>
                                <button class="btn-secondary w-full sm:w-auto" type="button" data-add-translation>Añadir traducción</button>
                            </div>
                            <% if (category.defaultDisplayName) { %>
                                <p class="text-xs text-discord-foreground/60">
                                    Valor por defecto: <%= category.defaultDisplayName.es || category.defaultDisplayName.en %>
                                </p>
                            <% } %>
                        </div>

                        <div class="space-y-3">
                            <label class="block text-sm font-medium text-discord-foreground">Mensaje con mención</label>
                            <div class="translations space-y-3 rounded-lg bg-discord-dark-300/60 p-4" data-translation-group>
                                <template>
                                    <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                                        <input type="text" name="mentionLocales[]" placeholder="Idioma" class="input w-full sm:w-36" />
                                        <input type="text" name="mentionValues[]" placeholder="%user% reaccionó a %user2%" class="input w-full sm:flex-1" />
                                        <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                                    </div>
                                </template>
                                <% Object.entries(category.mentionTemplate || {}).forEach(([locale, value]) => { %>
                                    <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                                        <input type="text" name="mentionLocales[]" value="<%= locale %>" class="input w-full sm:w-36" />
                                        <input type="text" name="mentionValues[]" value="<%= value %>" class="input w-full sm:flex-1" />
                                        <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                                    </div>
                                <% }) %>
                                <button class="btn-secondary w-full sm:w-auto" type="button" data-add-translation>Añadir traducción</button>
                            </div>
                            <% if (category.defaultMentionTemplate) { %>
                                <p class="text-xs text-discord-foreground/60">
                                    Por defecto: <%= category.defaultMentionTemplate.es || category.defaultMentionTemplate.en %>
                                </p>
                            <% } %>
                        </div>

                        <div class="space-y-3">
                            <label class="block text-sm font-medium text-discord-foreground">Mensaje simple</label>
                            <div class="translations space-y-3 rounded-lg bg-discord-dark-300/60 p-4" data-translation-group>
                                <template>
                                    <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                                        <input type="text" name="simpleLocales[]" placeholder="Idioma" class="input w-full sm:w-36" />
                                        <input type="text" name="simpleValues[]" placeholder="%user% reaccionó" class="input w-full sm:flex-1" />
                                        <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                                    </div>
                                </template>
                                <% Object.entries(category.simpleTemplate || {}).forEach(([locale, value]) => { %>
                                    <div class="translation-row flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
                                        <input type="text" name="simpleLocales[]" value="<%= locale %>" class="input w-full sm:w-36" />
                                        <input type="text" name="simpleValues[]" value="<%= value %>" class="input w-full sm:flex-1" />
                                        <button class="btn-secondary w-full sm:w-auto" type="button" data-remove-translation>Eliminar</button>
                                    </div>
                                <% }) %>
                                <button class="btn-secondary w-full sm:w-auto" type="button" data-add-translation>Añadir traducción</button>
                            </div>
                            <% if (category.defaultSimpleTemplate) { %>
                                <p class="text-xs text-discord-foreground/60">
                                    Por defecto: <%= category.defaultSimpleTemplate.es || category.defaultSimpleTemplate.en %>
                                </p>
                            <% } %>
                        </div>

                        <div class="flex flex-wrap justify-end gap-2">
                            <button class="btn-primary" type="submit">Guardar cambios</button>
                        </div>
                    </form>

                    <form
                        action="/admin/reactions/category/<%= category.key %>/delete"
                        method="POST"
                        class="flex flex-wrap justify-end"
                        onsubmit="return confirm('¿Seguro que deseas eliminar esta categoría?');"
                    >
                        <button class="btn-danger" type="submit">Eliminar categoría</button>
                    </form>
                </details>
            <% }) %>
        </div>
    </section>
</div>

<script>
    const categoryModal = document.getElementById('createCategoryModal');
    const modalDialog = categoryModal?.querySelector('[data-modal-dialog]');
    const modalForm = categoryModal?.querySelector('form');
    const openModalButtons = document.querySelectorAll('[data-open-category-modal]');
    const closeModalButtons = categoryModal ? categoryModal.querySelectorAll('[data-close-category-modal]') : [];

    const toggleBodyScroll = (lock) => {
        document.body.classList.toggle('overflow-hidden', lock);
    };

    const focusModalInput = () => {
        const firstInput = categoryModal?.querySelector('#new-category-key');
        if (firstInput instanceof HTMLInputElement) {
            firstInput.focus();
        }
    };

    const openCategoryModal = () => {
        if (!categoryModal) return;
        categoryModal.classList.remove('hidden');
        categoryModal.setAttribute('data-modal-state', 'open');
        toggleBodyScroll(true);
        window.setTimeout(focusModalInput, 0);
    };

    const closeCategoryModal = () => {
        if (!categoryModal) return;
        categoryModal.classList.add('hidden');
        categoryModal.setAttribute('data-modal-state', 'closed');
        toggleBodyScroll(false);
        modalForm?.reset();
        const modalGroups = categoryModal.querySelectorAll('[data-modal-group]');
        modalGroups.forEach((group) => {
            if (!(group instanceof HTMLElement)) {
                return;
            }
            const defaultRows = Number(group.getAttribute('data-default-rows') || '1');
            const rows = Array.from(group.querySelectorAll('.translation-row'));
            rows.forEach((row, index) => {
                if (index >= defaultRows) {
                    row.remove();
                }
            });
        });
    };

    openModalButtons.forEach((button) => {
        button.addEventListener('click', openCategoryModal);
    });

    closeModalButtons.forEach((button) => {
        button.addEventListener('click', () => {
            closeCategoryModal();
        });
    });

    categoryModal?.addEventListener('mousedown', (event) => {
        if (event.target === categoryModal) {
            closeCategoryModal();
        }
    });

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && categoryModal?.getAttribute('data-modal-state') === 'open') {
            closeCategoryModal();
        }
    });

    const translationGroups = document.querySelectorAll('[data-translation-group]');

    translationGroups.forEach((group) => {
        group.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof HTMLElement)) {
                return;
            }

            if (target.matches('[data-add-translation]')) {
                event.preventDefault();
                const template = group.querySelector('template');
                if (!template || !(template instanceof HTMLTemplateElement)) {
                    return;
                }
                const fragment = template.content.cloneNode(true);
                const firstElement = fragment.firstElementChild;
                if (firstElement) {
                    group.insertBefore(firstElement, target);
                    const inputs = firstElement.querySelectorAll('input');
                    inputs.forEach((input) => {
                        input.removeAttribute('value');
                        if (input instanceof HTMLInputElement) {
                            input.value = '';
                        }
                    });
                }
                return;
            }

            if (target.matches('[data-remove-translation]')) {
                event.preventDefault();
                const row = target.closest('.translation-row');
                if (!row) {
                    return;
                }
                const rows = group.querySelectorAll('.translation-row');
                if (rows.length <= 1) {
                    return;
                }
                row.remove();
            }
        });
    });
</script>
